# Local Docker Postgres:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rice_soccer
# AWS RDS (production):
# DATABASE_URL=postgresql://app_user:<password>@<rds-endpoint>:5432/rice_soccer?sslmode=require
DATABASE_URL=

# --- SAML2 SSO (Rice IAM) ---
# Signs the session cookie (modules/auth). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=
# true once this is served over HTTPS (required in production; python3-saml
# validates against the scheme the IdP actually saw).
SAML_FORCE_HTTPS=false

# This app's SP identity -- pick URLs under the domain this app is deployed on.
SAML_SP_ENTITY_ID=https://<this-app-domain>/saml/metadata
SAML_SP_ACS_URL=https://<this-app-domain>/saml/acs
# Optional, only if you wire up SP-initiated logout:
SAML_SP_SLO_URL=https://<this-app-domain>/saml/slo

# From Rice IAM's IdP metadata -- get these from whoever administers Rice's
# SAML IdP when registering this app as a service provider.
SAML_IDP_ENTITY_ID=
SAML_IDP_SSO_URL=
SAML_IDP_SLO_URL=
SAML_IDP_X509_CERT=

# Only needed if Rice IAM requires this app to sign its AuthnRequests --
# a PEM-encoded cert/key pair for this SP.
SAML_SP_X509_CERT=
SAML_SP_PRIVATE_KEY=
